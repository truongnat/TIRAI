{
  "private": true,
  "name": "tirai",
  "version": "1.0.0",
  "type": "module",
  "description": "TIRAI – TypeScript toolchain for Excel intelligence",
  "scripts": {
    "check": "npm run check --workspaces --if-present",
    "build:all": "npm run build --workspaces --if-present",
    "test:all": "npm test --workspaces --if-present",
    "verify:release": "npm run build:all && npm run test:all",
    "typecheck:all": "npm run typecheck --workspaces --if-present",
    "lint:all": "npm run lint --workspaces --if-present"
  },
  "workspaces": [
    "tools/deterministic/excel/workbook-inspector",
    "tools/deterministic/excel/cell-layout-extractor",
    "tools/deterministic/excel/officecli-adapter",
    "tools/deterministic/performance-benchmark",
    "tools/intelligent/contract-ir",
    "tools/intelligent/excel/context-builder",
    "tools/intelligent/source-ingestion",
    "tools/intelligent/semantic-analyzer",
    "tools/intelligent/requirement-builder",
    "tools/intelligent/test-planner",
    "tools/intelligent/test-data-planner",
    "tools/intelligent/data-resolver",
    "tools/intelligent/execution-engine",
    "tools/intelligent/database-executor",
    "tools/intelligent/api-executor",
    "tools/intelligent/test-execution-orchestrator",
    "tools/intelligent/ui-executor",
    "tools/intelligent/execution-mapping-builder",
    "tools/intelligent/project-adapter",
    "tools/intelligent/agentic-test-executor",
    "tools/intelligent/e2e-runner",
    "tools/intelligent/test-code-generator",
    "tools/intelligent/source-to-testcase",
    "tools/intelligent/tirai-cli"
  ],
  "devDependencies": {
    "typescript": "^5.5.0",
    "vitest": "^2.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "@eslint/js": "^9.0.0",
    "typescript-eslint": "^8.0.0",
    "prettier": "^3.3.0"
  }
}
