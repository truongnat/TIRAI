{
  "name": "execution-mapping-builder",
  "version": "1.0.0",
  "description": "Execution Mapping Builder v1 – Test Case IR → validated Test Execution Mapping IR",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "execution-mapping-builder": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "format": "prettier --write \"src/**/*.{ts,json}\" \"tests/**/*.{ts,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,json}\" \"tests/**/*.{ts,json}\"",
    "check": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "ai-provider": "file:../ai-provider",
    "test-planner": "file:../test-planner",
    "ui-executor": "file:../ui-executor",
    "test-execution-orchestrator": "file:../test-execution-orchestrator",
    "execution-engine": "file:../execution-engine",
    "semantic-analyzer": "file:../semantic-analyzer"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "vitest": "^2.0.0",
    "@types/node": "^22.0.0"
  }
}
