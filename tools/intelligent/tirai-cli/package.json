{
  "name": "tirai-cli",
  "version": "1.0.0",
  "description": "TIRAI workspace + CLI — developer-runnable product surface over frozen core",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "tirai": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/truongnat/TIRAI.git"
  },
  "keywords": [
    "tirai",
    "testing",
    "playwright",
    "vitest",
    "excel"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node build-bundle.mjs",
    "build:bundle": "node build-bundle.mjs",
    "prepack": "node scripts/prepack.mjs",
    "postpack": "node scripts/postpack.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "format": "prettier --write \"src/**/*.{ts,json}\" \"tests/**/*.{ts,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,json}\" \"tests/**/*.{ts,json}\"",
    "check": "npm run typecheck && npm run lint && npm run build && npm test"
  },
  "dependencies": {
    "ajv": "^8.17.0",
    "contract-ir": "file:../contract-ir",
    "docx": "^9.7.1",
    "exceljs": "^4.4.0",
    "pdf-lib": "^1.17.1",
    "source-to-testcase": "file:../source-to-testcase",
    "test-code-generator": "file:../test-code-generator",
    "test-execution-orchestrator": "file:../test-execution-orchestrator",
    "test-planner": "file:../test-planner",
    "ui-executor": "file:../ui-executor"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.21.5",
    "prettier": "^3.3.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
