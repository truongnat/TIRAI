{
  "name": "tirai-cli",
  "version": "1.0.0",
  "description": "TIRAI workspace + CLI — developer-runnable product surface over frozen core",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "tirai": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "format": "prettier --write \"src/**/*.{ts,json}\" \"tests/**/*.{ts,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,json}\" \"tests/**/*.{ts,json}\"",
    "check": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "source-to-testcase": "file:../source-to-testcase",
    "test-code-generator": "file:../test-code-generator",
    "ai-provider": "file:../ai-provider",
    "project-adapter": "file:../project-adapter",
    "execution-mapping-builder": "file:../execution-mapping-builder",
    "source-ingestion": "file:../source-ingestion"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "vitest": "^2.0.0",
    "@types/node": "^22.0.0"
  }
}
