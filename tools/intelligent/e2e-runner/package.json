{
  "name": "e2e-runner",
  "version": "1.0.0",
  "description": "End-to-End Test Runner v1 – product-level runtime entry point that orchestrates the complete test lifecycle",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "tirai-run": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "format": "prettier --write \"src/**/*.{ts,json}\" \"tests/**/*.{ts,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,json}\" \"tests/**/*.{ts,json}\"",
    "check": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "project-adapter": "file:../project-adapter",
    "execution-mapping-builder": "file:../execution-mapping-builder",
    "test-planner": "file:../test-planner",
    "test-data-planner": "file:../test-data-planner",
    "data-resolver": "file:../data-resolver",
    "execution-engine": "file:../execution-engine",
    "test-execution-orchestrator": "file:../test-execution-orchestrator",
    "ui-executor": "file:../ui-executor",
    "database-executor": "file:../database-executor",
    "api-executor": "file:../api-executor",
    "requirement-builder": "file:../requirement-builder",
    "ai-provider": "file:../ai-provider",
    "semantic-analyzer": "file:../semantic-analyzer",
    "source-ingestion": "file:../source-ingestion"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "vitest": "^2.0.0",
    "@types/node": "^22.0.0",
    "playwright": "^1.62.0"
  }
}
