<script>
// — starfield —
const starCanvas = document.getElementById('stars');
const sctx = starCanvas.getContext('2d');
let W, H, stars;
function resize() {
  W = starCanvas.width = innerWidth;
  H = starCanvas.height = innerHeight;
  stars = Array.from({length: 220}, () => ({
    x: Math.random()*W, y: Math.random()*H,
    r: Math.random()*1.4 + .3,
    s: Math.random()*.25 + .05,
    a: Math.random()*Math.PI*2,
  }));
}
resize(); addEventListener('resize', resize);
(function drawStars() {
  sctx.clearRect(0,0,W,H);
  for (const s of stars) {
    s.a += .02;
    s.y -= s.s; if (s.y < 0) s.y = H;
    sctx.beginPath();
    sctx.arc(s.x, s.y, s.r, 0, 7);
    sctx.fillStyle = `rgba(230,235,255,${.35 + Math.sin(s.a)*.3})`;
    sctx.fill();
  }
  requestAnimationFrame(drawStars);
})();

// — nebula blobs —
const neb = document.getElementById('nebula');
neb.innerHTML = '';
const colors = ['94,234,212','167,139,250','244,114,182','96,165,250'];
for (let i = 0; i < 5; i++) {
  const d = document.createElement('div');
  const c = colors[i % colors.length];
  const size = 400 + Math.random()*500;
  d.style.cssText = `position:absolute;width:${size}px;height:${size}px;border-radius:50%;
    background:radial-gradient(circle,rgba(${c},.14) 0%,transparent 65%);
    left:${Math.random()*100}%;top:${Math.random()*100}%;
    animation:nebDrift ${30+i*12}s ease-in-out infinite alternate;filter:blur(40px)`;
  neb.appendChild(d);
}
const style = document.createElement('style');
style.textContent = `@keyframes nebDrift{from{transform:translate(0,0) scale(1)}to{transform:translate(${'-80px'},60px) scale(1.15)}}`;
document.head.appendChild(style);

// — three.js hero orb —
import('https://unpkg.com/three@0.160.0/build/three.module.js').then(({ default: THREE, ...THREE_NS }) => {
  const T = { ...THREE_NS, ...THREE } || THREE_NS;
}).catch(() => {});
// Load via module script below instead
</script>
<script type="module">
import * as THREE from 'https://unpkg.com/three@0.160.0/build/three.module.js';

const canvas = document.getElementById('hero3d');
const renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: true });
renderer.setPixelRatio(Math.min(devicePixelRatio, 2));
const scene = new THREE.Scene();
const camera = new THREE.PerspectiveCamera(50, innerWidth/innerHeight, .1, 100);
camera.position.z = 7;

// wireframe torus knot — the "spec orb"
const knot = new THREE.Mesh(
  new THREE.TorusKnotGeometry(1.6, .42, 180, 24, 2, 3),
  new THREE.MeshBasicMaterial({ color: 0x5eead4, wireframe: true, transparent: true, opacity: .14 })
);
scene.add(knot);

// inner glowing icosahedron
const ico = new THREE.Mesh(
  new THREE.IcosahedronGeometry(.7, 1),
  new THREE.MeshBasicMaterial({ color: 0xa78bfa, wireframe: true, transparent: true, opacity: .35 })
);
scene.add(ico);

// orbit particles
const pGeo = new THREE.BufferGeometry();
const N = 700, pos = new Float32Array(N*3);
for (let i=0;i<N;i++) {
  const r = 3 + Math.random()*5;
  const t = Math.random()*Math.PI*2, p = Math.acos(2*Math.random()-1);
  pos[i*3]   = r*Math.sin(p)*Math.cos(t);
  pos[i*3+1] = r*Math.sin(p)*Math.sin(t)*.45;
  pos[i*3+2] = r*Math.cos(p)*.6;
}
pGeo.setAttribute('position', new THREE.BufferAttribute(pos, 3));
const particles = new THREE.Points(pGeo, new THREE.PointsMaterial({
  color: 0x9aa8ff, size: .025, transparent: true, opacity: .8
}));
scene.add(particles);

let mx = 0, my = 0;
addEventListener('mousemove', e => {
  mx = (e.clientX/innerWidth - .5)*2;
  my = (e.clientY/innerHeight - .5)*2;
});
function size() {
  renderer.setSize(innerWidth, innerHeight);
  camera.aspect = innerWidth/innerHeight;
  camera.updateProjectionMatrix();
}
size(); addEventListener('resize', size);

let scrollY = 0;
addEventListener('scroll', () => scrollY = window.scrollY, { passive: true });

(function tick(t) {
  requestAnimationFrame(tick);
  const s = t*.0001;
  knot.rotation.x = s*3 + my*.4;
  knot.rotation.y = s*4 + mx*.6;
  ico.rotation.x = -s*5; ico.rotation.y = s*6;
  particles.rotation.y = s*.8;
  particles.rotation.x = Math.sin(s*.5)*.1 + my*.15;
  const fade = Math.max(0, 1 - scrollY/(innerHeight*.9));
  knot.material.opacity = .14*fade;
  ico.material.opacity = .35*fade;
  particles.material.opacity = .8*fade;
  camera.position.y = scrollY*-.0015;
  renderer.render(scene, camera);
})(0);
</script>

<script>
// scroll reveal
const io = new IntersectionObserver(es => es.forEach(e => {
  if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
}), { threshold: .12 });
document.querySelectorAll('.reveal').forEach(el => io.observe(el));
document.querySelectorAll('#trustList li').forEach((el, i) => {
  setTimeout(() => io.observe(el), i*80);
});
</script>

